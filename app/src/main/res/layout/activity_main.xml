<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Ringkasan Target & Progres -->
    <TextView
        android:id="@+id/tvTargetPesan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Target: 2000 mL | Ayo mulai minum!"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressBarHydration"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        app:layout_constraintTop_toBottomOf="@id/tvTargetPesan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTotalVolume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Terkumpul: 0 mL (0%) | 0 Aktivitas"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/progressBarHydration"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Form Input Air & Jenis Minuman -->
    <EditText
        android:id="@+id/etJumlahAir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:hint="Jumlah Air (mL)"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/tvTotalVolume"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/etJenisMinuman" />

    <EditText
        android:id="@+id/etJenisMinuman"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Jenis Minuman"
        android:inputType="text"
        app:layout_constraintTop_toTopOf="@id/etJumlahAir"
        app:layout_constraintBottom_toBottomOf="@id/etJumlahAir"
        app:layout_constraintStart_toEndOf="@id/etJumlahAir"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSimpan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Simpan Catatan"
        app:layout_constraintTop_toBottomOf="@id/etJumlahAir"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Daftar Catatan Sementara -->
    <TextView
        android:id="@+id/tvLabelRiwayat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Catatan Konsumsi Sementara"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnSimpan"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRiwayatMinum"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelRiwayat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>